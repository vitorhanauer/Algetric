  <ItemGroup>
    <Content Include="Web/**/*" Exclude="Web/node_modules/**/*;Web/package*.json;Web/build.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
